{
  "$schema": "https://json.schemastore.org/semantic-release.json",
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    {
      "name": "next",
      "prerelease": true
    }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "breaking": true,
            "release": "major"
          },
          {
            "revert": true,
            "release": "patch"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "scope": "rules",
            "release": "patch"
          },
          {
            "type": "refactor",
            "scope": "presets",
            "release": "patch"
          },
          {
            "type": "chore",
            "scope": "upstream",
            "release": "patch"
          },
          {
            "type": "docs",
            "scope": "readme",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "refactor",
              "scope": "rules",
              "section": "Rule Internals"
            },
            {
              "type": "refactor",
              "scope": "presets",
              "section": "Rule Internals"
            },
            {
              "type": "chore",
              "scope": "upstream",
              "section": "Upstream Sync"
            },
            {
              "type": "docs",
              "scope": "readme",
              "section": "Documentation"
            },
            {
              "type": "docs",
              "section": "Documentation",
              "hidden": true
            },
            {
              "type": "refactor",
              "section": "Refactoring",
              "hidden": true
            },
            {
              "type": "test",
              "section": "Tests",
              "hidden": true
            },
            {
              "type": "build",
              "section": "Build",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "CI",
              "hidden": true
            },
            {
              "type": "style",
              "section": "Style",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "Chores",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. This file is generated by [semantic-release](https://github.com/semantic-release/semantic-release) from [Conventional Commits](https://www.conventionalcommits.org/); do not edit it by hand."
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/sync-version.js ${nextRelease.version} ${lastRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json",
          "README.md",
          "SECURITY.md",
          "rules/index.grit",
          "rules/recommended-strict.grit"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "failTitle": "The automated release is failing"
      }
    ]
  ]
}
