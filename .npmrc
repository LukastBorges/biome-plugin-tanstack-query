# Project-level npm configuration (never published: npm always excludes .npmrc).
#
# No dependency of this repository needs an install script, so none may run.
# This blocks the most common npm supply-chain attack vector (malicious
# preinstall/postinstall hooks). `npm run <script>` / `npm test` still work;
# only implicit lifecycle hooks (pre*/post*/prepare/...) are skipped.
ignore-scripts=true
fund=false
