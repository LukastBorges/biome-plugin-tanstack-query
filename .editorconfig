# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Trailing double spaces are hard line breaks in Markdown.
trim_trailing_whitespace = false
max_line_length = off

# Fixtures are compared byte-for-byte with Biome's output (invalid.fixed.tsx,
# invalid.unsafe-fixed.tsx): never let an editor reformat them.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
max_line_length = off
